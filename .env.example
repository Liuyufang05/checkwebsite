# Copy this file to backend/.env and fill in the keys you have.
# Every key is OPTIONAL - a missing key shows "not configured" for that panel.

# Google Safe Browsing (free): https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=
# VirusTotal (free tier: 4 lookups/min, 500/day): https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# urlscan.io (free): https://urlscan.io/user/profile/  -> Settings & API -> New API key
URLSCAN_API_KEY=
# public | unlisted | private (private needs a paid plan)
URLSCAN_VISIBILITY=unlisted

# Optional tuning
# RATE_LIMIT_PER_MINUTE=10
# SCREENSHOT_ENABLED=true
# TOTAL_SCAN_BUDGET_S=40
# CACHE_TTL_S=900
